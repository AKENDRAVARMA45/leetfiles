class Solution {
    public int findContentChildren(int[] g, int[] s) {
        Arrays.sort(g);
        Arrays.sort(s);

        int i = 0;
        int j = 0;
        int count = 0;

        while(i<g.length && j<s.length){
            if(s[i]>=g[i]){
                count ++;
                i++;
                j++;
            }
            else{
                j++;
            }
        }
        return count;
    }
}



------------------------------------------------------------------------------
T.c  = O(n log n + m log m)
s.c = O(1)
