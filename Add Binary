class Solution {
    public String addBinary(String a, String b) {
        int i = a.length()-1;
        int j = b.length()-1;
        int carry = 0;

        StringBuilder sb = new StringBuilder();
        while(i >= 0 || j>=0 || carry>0){
            int digitA = 0;
            int digitB = 0;

            if(i>=0){
                digitA = a.charAt(i)-'0';
            }
            if(j>=0){
                digitB = b.charAt(j)-'0';
            }

            int sum = digitA + digitB + carry;

            sb.append(sum%2);
            carry = sum/2;

            i--;
            j--;

        }
        return sb.reverse().toString();
    }
}
--------------------------------------------------------------------
T.c = O(max(n,m))
S.c = O(max(n,m))
